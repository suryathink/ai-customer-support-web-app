{
  "name": "ai-customer-support-server",
  "version": "1.0.0",
  "private": true,
  "description": "Express API for the AI customer support chat app",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc -p tsconfig.prod.json",
    "start": "node -r module-alias/register ./dist",
    "lint": "tsc --noEmit"
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "ts",
    "exec": "ts-node --files -r tsconfig-paths/register ./src"
  },
  "_moduleAliases": {
    "@src": "dist"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^4.22.3",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "joi": "^18.3.1",
    "jsonwebtoken": "^9.0.3",
    "log4js": "^6.9.1",
    "module-alias": "^2.3.5",
    "mongoose": "^9.11.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/module-alias": "^2.0.4",
    "@types/node": "^26.6.6",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
