# development | production
NODE_ENV=development
PORT=5000

# Your MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ai_support

# Comma-separated list of allowed frontend origins
# (http://localhost:3000 with Docker, http://localhost:5173 with `npm run dev`)
CLIENT_ORIGIN=http://localhost:3000

# Use a long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Defaults to true when NODE_ENV=production (requires HTTPS)
# COOKIE_SECURE=false

# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OPENROUTER_TIMEOUT_MS=30000
# AI_CONTEXT_MESSAGES=10

# Rate limiting
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=10
# CHAT_RATE_LIMIT_WINDOW_MS=60000
# CHAT_RATE_LIMIT_MAX=20
