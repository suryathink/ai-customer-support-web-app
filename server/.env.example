# development | production
NODE_ENV=development
PORT=5000

# Local:  mongodb://localhost:27017/ai_support
# Docker dev compose sets this to its own mongo container automatically.
# Production: your MongoDB Atlas connection string
MONGO_URI=mongodb://localhost:27017/ai_support

# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# Use a long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Defaults to true when NODE_ENV=production (requires HTTPS)
# COOKIE_SECURE=false

# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OPENROUTER_TIMEOUT_MS=30000
# AI_CONTEXT_MESSAGES=10

# Rate limiting
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=10
# CHAT_RATE_LIMIT_WINDOW_MS=60000
# CHAT_RATE_LIMIT_MAX=20
